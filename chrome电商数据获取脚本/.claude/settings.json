{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \".claude/hooks/check_docs.py\" --event post-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \".claude/hooks/check_docs.py\" --event stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
